@page
@model GtViewer.Web.Pages.Catalogo.NovoModel
@{
    ViewData["Title"] = "Novo Aplicativo - Catálogo";
}

<div class="container py-3" style="max-width: 800px;">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h2 class="mb-0">Cadastrar Novo Aplicativo</h2>
            <small class="text-muted">Apenas instaladores assinados digitalmente (Authenticode) são permitidos.</small>
        </div>
        <a class="btn btn-outline-secondary btn-sm" asp-page="/Catalogo/Index">Voltar</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.MensagemErro))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Model.MensagemErro
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form method="post" enctype="multipart/form-data">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Nome" class="form-label fw-bold">Nome do Aplicativo</label>
                        <input asp-for="Nome" class="form-control" placeholder="Ex.: Mozilla Firefox Enterprise" />
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Versao" class="form-label fw-bold">Versão</label>
                        <input asp-for="Versao" class="form-control" placeholder="Ex.: 128.0.3" />
                        <span asp-validation-for="Versao" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="FabricanteEsperado" class="form-label fw-bold">Fabricante Esperado no Certificado Digital</label>
                        <input asp-for="FabricanteEsperado" class="form-control" placeholder="Ex.: Mozilla Corporation (Publisher / Subject Authenticode)" />
                        <small class="text-muted">O servidor e o agente Windows rejeitam instaladores cujo certificado não pertença a este fabricante.</small>
                        <span asp-validation-for="FabricanteEsperado" class="text-danger small d-block"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Arquivo" class="form-label fw-bold">Instalador (.msi ou .exe, até 500 MB)</label>
                        <input asp-for="Arquivo" class="form-control" type="file" accept=".msi,.exe" />
                        <small class="text-muted">O hash SHA-256 e a assinatura digital serão validados automaticamente no upload.</small>
                        <span asp-validation-for="Arquivo" class="text-danger small d-block"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ParametrosInstalacao" class="form-label fw-bold">Parâmetros de Instalação Silenciosa</label>
                        <input asp-for="ParametrosInstalacao" class="form-control font-monospace" placeholder="Ex.: /quiet /norestart" />
                        <small class="text-muted">Para MSI, o prefixo /i é adicionado automaticamente pelo agente.</small>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ComandoRemocao" class="form-label fw-bold">Comando de Remoção Silenciosa</label>
                        <input asp-for="ComandoRemocao" class="form-control font-monospace" placeholder="Ex.: msiexec /x {GUID} /qn" />
                    </div>

                    <div class="col-12 mt-4">
                        <h5 class="border-bottom pb-2">Regra de Detecção de Presença</h5>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="RegraDeteccaoTipo" class="form-label fw-bold">Tipo de Detecção</label>
                        <select asp-for="RegraDeteccaoTipo" class="form-select">
                            <option value="registro">Registro do Windows</option>
                            <option value="arquivo">Arquivo em Disco</option>
                        </select>
                    </div>

                    <div class="col-md-8">
                        <label asp-for="RegraDeteccaoChave" class="form-label fw-bold">Chave de Registro ou Caminho do Arquivo</label>
                        <input asp-for="RegraDeteccaoChave" class="form-control font-monospace" placeholder="Ex.: HKLM:\Software\Mozilla\Mozilla Firefox ou C:\Program Files\..." />
                        <span asp-validation-for="RegraDeteccaoChave" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="RegraDeteccaoValor" class="form-label fw-bold">Valor / Versão Esperada (Opcional)</label>
                        <input asp-for="RegraDeteccaoValor" class="form-control" placeholder="Deixe em branco para testar apenas a existência da chave/arquivo" />
                    </div>

                    <div class="col-12 text-end mt-4">
                        <a class="btn btn-outline-secondary me-2" asp-page="/Catalogo/Index">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4">Salvar no Catálogo</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
