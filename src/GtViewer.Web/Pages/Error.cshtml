@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

@if (Model.IsAccessDenied)
{
    <div class="row justify-content-center mt-5">
        <div class="col-md-6 text-center">
            <h1 class="display-1 text-danger fw-bold">403</h1>
            <h3 class="fw-bold text-dark">Acesso Não Autorizado</h3>
            <p class="text-muted mt-3">
                Você não possui a permissão necessária para executar esta ação ou acessar esta funcionalidade.
            </p>
            <div class="mt-4">
                <a asp-page="/Index" class="btn btn-primary">Voltar para a Página Inicial</a>
            </div>
        </div>
    </div>
}
else
{
    <h1 class="text-danger">Error.</h1>
    <h2 class="text-danger">An error occurred while processing your request.</h2>

    @if (Model.ShowRequestId)
    {
        <p>
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }
}
