@page "{id:int}"
@model GtViewer.Web.Pages.Maquinas.DetalhesModel
@{
    ViewData["Title"] = $"Máquina {Model.Maquina?.NumeroSerie} (J3)";
}

@if (Model.Maquina == null)
{
    <div class="alert alert-danger">Máquina não encontrada.</div>
}
else
{
    var m = Model.Maquina;
    <div class="container-fluid py-2">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2>
                    <i class="bi bi-laptop"></i> @m.NumeroSerie
                    @if (m.SerieManual)
                    {
                        <span class="badge bg-info text-dark ms-2">Série Manual</span>
                    }
                    @if (m.EmAprovacao)
                    {
                        <span class="badge bg-warning text-dark ms-2">Aguardando Aprovação</span>
                    }
                </h2>
                <p class="text-muted mb-0">Hostname: <code>@(m.Hostname ?? "N/A")</code> | NodeId: <code>@(m.NodeId ?? "N/A")</code></p>
            </div>
            <div class="d-flex gap-2 align-items-center">
                <a asp-page="./Index" class="btn btn-outline-secondary btn-sm">Voltar</a>
                @if (User.HasPermissao(GtViewer.Web.Security.Permissoes.SuporteRemoto) && m.ConexaoEstado == "online")
                {
                    <a asp-page="/RemoteSupport" asp-route-nodeId="@m.NodeId" class="btn btn-primary btn-sm">
                        <i class="bi bi-display"></i> Acessar Tela
                    </a>
                }
                @if (Model.PodeReiniciar)
                {
                    <form method="post" asp-page-handler="Reiniciar" asp-route-id="@m.Id" class="d-inline" onsubmit="return confirm('Deseja realmente reiniciar este computador? O usuário receberá um aviso prévio de 2 minutos para salvar seu trabalho.');">
                        <button type="submit" class="btn btn-outline-warning btn-sm" @(m.ConexaoEstado == "online" && Model.MeshCentralConectado ? "" : "disabled") title="@(m.ConexaoEstado != "online" ? "Reinício indisponível com a máquina offline." : !Model.MeshCentralConectado ? "Sem conexão com o servidor de máquinas (MeshCentral)." : "Reiniciar o computador com aviso de 2 minutos ao usuário")">
                            <i class="bi bi-arrow-clockwise"></i> Reiniciar
                        </button>
                    </form>
                }
                @if (Model.PodeBloquear && m.BloqueioEstado != "bloqueada" && m.BloqueioEstado != "bloqueio_pendente")
                {
                    <button type="button" class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#modalBloquear">
                        <i class="bi bi-lock"></i> Bloquear
                    </button>
                }
                @if (Model.PodeBloquear && (m.BloqueioEstado is "bloqueada" or "bloqueio_pendente" or "desbloqueio_pendente" or "falha"))
                {
                    <form method="post" asp-page-handler="Desbloquear" asp-route-id="@m.Id" class="d-inline" onsubmit="return confirm('Confirmar o desbloqueio desta máquina?');">
                        <button type="submit" class="btn btn-success btn-sm">
                            <i class="bi bi-unlock"></i> Desbloquear
                        </button>
                    </form>
                }
                @if (Model.PodeRevelarSenha)
                {
                    <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#modalRevelarSenha" @(Model.PodeRevelarSenhaAgora ? "" : "disabled") title="@Model.MotivoIndisponivelRevelar">
                        <i class="bi bi-key"></i> Revelar Senha
                    </button>
                }
            </div>
        </div>

        @if (!Model.MeshCentralConectado)
        {
            <div class="alert alert-warning py-2 small mb-3">
                <i class="bi bi-exclamation-triangle-fill"></i> Sem conexão com o servidor de máquinas (MeshCentral) — reinício, tela remota e revelar senha ficam indisponíveis.
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.MensagemSucesso))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle"></i> @Model.MensagemSucesso
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.MensagemErro))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle"></i> @Model.MensagemErro
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.SenhaRevelada))
        {
            <div class="alert alert-warning border border-danger shadow-sm my-3 p-3">
                <h5 class="alert-heading text-danger fw-bold"><i class="bi bi-shield-exclamation"></i> Senha de Resgate Revelada</h5>
                <p class="mb-2">Passe esta senha para o usuário local efetuar o logon na máquina:</p>
                <div class="input-group mb-2" style="max-width: 450px;">
                    <input type="text" class="form-control font-monospace fw-bold fs-5 text-center bg-light" id="inputSenhaRevelada" value="@Model.SenhaRevelada" readonly />
                    <button class="btn btn-outline-dark" type="button" onclick="navigator.clipboard.writeText(document.getElementById('inputSenhaRevelada').value); alert('Senha copiada!');">
                        <i class="bi bi-clipboard"></i> Copiar
                    </button>
                </div>
                <small class="text-danger fw-semibold d-block">
                    <i class="bi bi-clock-history"></i> Esta senha será alterada automaticamente e a sessão da conta de resgate será encerrada assim que a máquina reconectar à internet.
                </small>
            </div>
        }

        <div class="row g-3">
            <!-- Coluna da Esquerda: Dados de Hardware e Estados -->
            <div class="col-md-6">
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-light fw-bold">
                        <i class="bi bi-info-circle"></i> Informações do Dispositivo
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Status Conexão:</dt>
                            <dd class="col-sm-8">
                                <span class="badge @(m.ConexaoEstado == "online" ? "bg-success" : m.ConexaoEstado == "sumida" ? "bg-danger" : "bg-secondary")">
                                    @m.ConexaoEstado.ToUpperInvariant()
                                </span>
                            </dd>

                            <dt class="col-sm-4">Status Bloqueio:</dt>
                            <dd class="col-sm-8">
                                <span class="badge @(m.BloqueioEstado == "bloqueada" ? "bg-danger" : "bg-secondary")">
                                    @m.BloqueioEstado.ToUpperInvariant()
                                </span>
                            </dd>

                            <dt class="col-sm-4">Contrato Locadora:</dt>
                            <dd class="col-sm-8">
                                <span class="badge @(m.SituacaoContrato == "no_contrato" ? "bg-success" : m.SituacaoContrato == "fora_do_contrato" ? "bg-danger" : "bg-secondary")">
                                    @m.SituacaoContrato.Replace("_", " ").ToUpperInvariant()
                                </span>
                            </dd>

                            <dt class="col-sm-4">Fabricante / Modelo:</dt>
                            <dd class="col-sm-8">@(m.Fabricante ?? "-") / @(m.Modelo ?? "-")</dd>

                            <dt class="col-sm-4">Sistema Operacional:</dt>
                            <dd class="col-sm-8">@(m.SistemaOperacional ?? "-") (@(m.Arquitetura ?? "-"))</dd>

                            <dt class="col-sm-4">Antivírus:</dt>
                            <dd class="col-sm-8">
                                <div>@(m.AntivirusNome ?? "Nenhum detectado")</div>
                                <span class="badge @(m.AntivirusStatus == "Ativo e Atualizado" ? "bg-success" : "bg-warning text-dark")">
                                    @m.AntivirusStatus
                                </span>
                            </dd>

                            <dt class="col-sm-4">Grupo:</dt>
                            <dd class="col-sm-8">@(m.GrupoNome ?? "Nenhum")</dd>

                            <dt class="col-sm-4">Primeiro Contato:</dt>
                            <dd class="col-sm-8">@(m.PrimeiroContatoEm?.ToString("dd/MM/yyyy HH:mm:ss") ?? "-")</dd>

                            <dt class="col-sm-4">Último Contato:</dt>
                            <dd class="col-sm-8">@(m.UltimoContatoEm?.ToString("dd/MM/yyyy HH:mm:ss") ?? "-")</dd>
                        </dl>
                    </div>
                </div>

                <!-- Histórico de Usuários Interativos (Invariante 12) -->
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-light fw-bold">
                        <i class="bi bi-people"></i> Histórico de Sessões de Usuários (LGPD - 2 anos)
                    </div>
                    <div class="card-body p-0 table-responsive" style="max-height: 250px;">
                        <table class="table table-sm table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>Usuário</th>
                                    <th>Início da Sessão</th>
                                    <th>Fim da Sessão</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (m.HistoricoUsuarios.Count == 0)
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-2">Nenhum histórico registrado ainda.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var h in m.HistoricoUsuarios)
                                    {
                                        <tr>
                                            <td><strong>@h.Usuario</strong></td>
                                            <td>@h.InicioEm.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@(h.FimEm.HasValue ? h.FimEm.Value.ToString("dd/MM/yyyy HH:mm") : "Sessão Ativa")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Coluna da Direita: Fila de Ações e Auditoria -->
            <div class="col-md-6">
                <!-- Ações Pendentes / Em Execução -->
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-light fw-bold">
                        <i class="bi bi-list-task"></i> Ações Pendentes / Fila
                    </div>
                    <div class="card-body p-0 table-responsive" style="max-height: 200px;">
                        <table class="table table-sm table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Tipo</th>
                                    <th>Prioridade</th>
                                    <th>Estado</th>
                                    <th>Ator</th>
                                    <th>Criado Em</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (m.AcoesPendentes.Count == 0)
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-2">Nenhuma ação pendente na fila.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var a in m.AcoesPendentes)
                                    {
                                        <tr>
                                            <td><code>@a.Tipo</code></td>
                                            <td><span class="badge bg-secondary">P@(a.Prioridade)</span></td>
                                            <td><span class="badge bg-info text-dark">@a.Estado</span></td>
                                            <td>@a.Ator</td>
                                            <td>@a.CriadoEm.ToString("dd/MM/yyyy HH:mm")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Últimas Ações de Auditoria -->
                <div class="card shadow-sm">
                    <div class="card-header bg-light fw-bold">
                        <i class="bi bi-clock-history"></i> Últimas Auditorias Deste Dispositivo
                    </div>
                    <div class="card-body p-0 table-responsive" style="max-height: 280px;">
                        <table class="table table-sm table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>Data/Hora</th>
                                    <th>Ator</th>
                                    <th>Ação Auditada</th>
                                    <th>Resultado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (m.UltimasAuditorias.Count == 0)
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-2">Nenhuma auditoria registrada.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var aud in m.UltimasAuditorias)
                                    {
                                        <tr>
                                            <td><small>@aud.DataHora.ToString("dd/MM/yyyy HH:mm:ss")</small></td>
                                            <td><strong>@aud.Ator</strong></td>
                                            <td><code>@aud.Tipo</code></td>
                                            <td>
                                                <span class="badge @(aud.Sucesso ? "bg-success" : "bg-danger")">
                                                    @(aud.Sucesso ? "OK" : "Falha")
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal Bloquear Máquina -->
        <div class="modal fade" id="modalBloquear" tabindex="-1" aria-labelledby="modalBloquearLabel" aria-hidden="true">
            <div class="modal-dialog">
                <form method="post" asp-page-handler="Bloquear" asp-route-id="@m.Id">
                    <div class="modal-content">
                        <div class="modal-header bg-warning">
                            <h5 class="modal-title" id="modalBloquearLabel"><i class="bi bi-lock-fill"></i> Bloquear Equipamento</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                        </div>
                        <div class="modal-body">
                            <p>O bloqueio restringirá o logon exclusivamente à conta local de resgate e desconectará o usuário ativo.</p>
                            <div class="mb-3">
                                <label for="motivoBloqueio" class="form-label fw-bold">Motivo do Bloqueio (obrigatório):</label>
                                <textarea name="motivo" id="motivoBloqueio" class="form-control" rows="3" required placeholder="Ex.: Colaborador desligado da empresa / Perda do equipamento"></textarea>
                                <div class="form-text">Esta mensagem ficará registrada na auditoria e será exibida na tela de login do Windows.</div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-danger"><i class="bi bi-lock"></i> Confirmar Bloqueio</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Modal Revelar Senha de Resgate -->
        <div class="modal fade" id="modalRevelarSenha" tabindex="-1" aria-labelledby="modalRevelarSenhaLabel" aria-hidden="true">
            <div class="modal-dialog">
                <form method="post" asp-page-handler="RevelarSenha" asp-route-id="@m.Id">
                    <div class="modal-content">
                        <div class="modal-header bg-danger text-white">
                            <h5 class="modal-title" id="modalRevelarSenhaLabel"><i class="bi bi-shield-lock-fill"></i> Revelar Senha de Resgate</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
                        </div>
                        <div class="modal-body">
                            <div class="alert alert-warning small mb-3">
                                <i class="bi bi-exclamation-triangle"></i> Esta ação é estritamente auditada. Passe a senha de resgate ao usuário apenas por telefone para permitir conexão à internet.
                            </div>
                            <div class="mb-3">
                                <label for="totpCode" class="form-label fw-bold">Código do Autenticador (2FA/TOTP):</label>
                                <input type="text" name="totpCode" id="totpCode" class="form-control text-center font-monospace fs-4" maxlength="6" pattern="[0-9]{6}" required placeholder="000000" autofocus />
                                <div class="form-text">Informe o código de 6 dígitos gerado pelo seu app autenticador.</div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-danger"><i class="bi bi-key-fill"></i> Confirmar e Revelar</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
