@page "/login/verificar-2fa"
@model GtViewer.Web.Pages.Login.Verificar2FaModel
@{
    ViewData["Title"] = "Verificação em Duas Etapas (2FA)";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <h3 class="fw-bold text-primary">Autenticação 2FA</h3>
                    <p class="text-muted">Insira o código de 6 dígitos gerado pelo seu aplicativo autenticador</p>
                </div>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger" role="alert">
                        @Model.ErrorMessage
                    </div>
                }

                <form method="post">
                    <input type="hidden" name="TecnicoId" value="@Model.TecnicoId" />
                    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

                    <div class="mb-4">
                        <label for="TotpCode" class="form-label text-center d-block">Código de Segurança</label>
                        <input type="text" class="form-control form-control-lg text-center font-monospace" id="TotpCode" name="TotpCode" maxlength="6" placeholder="000000" required autofocus autocomplete="one-time-code" />
                        <div class="form-text text-center">5 códigos errados travam a conta por 15 minutos.</div>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">Entrar</button>
                    </div>
                </form>
            </div>
            <div class="card-footer bg-light text-center py-3">
                <a asp-page="/Login" class="text-decoration-none small text-muted">Voltar para a tela de login</a>
            </div>
        </div>
    </div>
</div>
