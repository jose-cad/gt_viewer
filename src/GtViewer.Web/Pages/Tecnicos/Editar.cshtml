@page "/tecnicos/editar/{id:int}"
@model GtViewer.Web.Pages.Tecnicos.EditarModel
@{
    ViewData["Title"] = "Editar Permissões";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h4 class="mb-0 fw-bold text-dark">Editar Permissões — @Model.TecnicoNome (@Model.UsuarioDominio)</h4>
                    <small class="text-muted">Ajuste as permissões atribuídas a este técnico. Alterações entram em vigor imediatamente.</small>
                </div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @Model.ErrorMessage
                        </div>
                    }

                    <form method="post">
                        <input type="hidden" name="Id" value="@Model.Id" />

                        <div class="row g-3 mb-4">
                            @foreach (var perm in Model.TodasPermissoes)
                            {
                                <div class="col-md-6">
                                    <div class="form-check p-3 border rounded bg-light">
                                        <input class="form-check-input" type="checkbox" name="PermissoesSelecionadas" value="@perm.Chave" id="perm_@perm.Chave" @(Model.PermissoesSelecionadas.Contains(perm.Chave) ? "checked" : "") />
                                        <label class="form-check-label fw-bold" for="perm_@perm.Chave">
                                            @perm.Nome
                                        </label>
                                        <div class="text-muted small">@perm.Descricao</div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-page="/Tecnicos/Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary px-4">Salvar Permissões</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
